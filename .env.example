# Supabase client keys (exposed to browser)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=public-anon-key

# Supabase service credentials (server-side only)
SUPABASE_SERVICE_ROLE_KEY=service-role-key
SUPABASE_JWT_SECRET=jwt-secret
ALLOWED_EMAIL=you@yourdomain.com
CRON_SECRET=64-character-random-hex

# Optional emergency login. Generate a fresh password hash and independent key;
# if either is absent or malformed, bypass login is disabled fail-closed.
BYPASS_PASSWORD_SHA256=64-character-sha256-hex
BYPASS_COOKIE_HMAC_KEY=64-character-random-hex

# Amazon SES SMTP credentials
AWS_SES_SMTP_USERNAME=ses-username
AWS_SES_SMTP_PASSWORD=ses-password
AWS_SES_SMTP_ENDPOINT=email-smtp.us-east-1.amazonaws.com
AWS_SES_SMTP_PORT=587
AWS_SES_CONFIGURATION_SET=knotable-tracking
AWS_SES_SNS_TOPIC_ARN=arn:aws:sns:us-east-1:123456789012:knotable-ses-events

# AWS-native large-campaign execution plane (S3 manifest + DynamoDB state)
AWS_REGION=us-east-1
AWS_SES_NATIVE_CONFIGURATION_SET=knotable-native-tracking
SES_CAMPAIGN_BUCKET=private-ses-campaign-manifests
SES_CAMPAIGN_STATE_TABLE=props-mailer-ses-native-state
SES_BULK_MAX_RECIPIENTS_PER_SECOND=13
SES_UNSUBSCRIBE_BASE_URL=https://replace-with-approved-aws-unsubscribe-endpoint.example/
SES_UNSUBSCRIBE_SECRET_ARN=arn:aws:secretsmanager:us-east-1:123456789012:secret:replace-me
SES_OPERATOR_EMAIL=you@yourdomain.com
SES_APP_URL=https://your-app.example.com

# Narrow Actions:write token used only by the authenticated app control page
AWS_NATIVE_CONTROL_ENABLED=false
GITHUB_ACTIONS_DISPATCH_TOKEN=fine-grained-token
GITHUB_REPOSITORY=Knotable/knotable-props-mailer
GITHUB_ACTIONS_REF=master

# Application base URL used by app-generated links and internal callbacks
APP_BASE_URL=http://localhost:3000
